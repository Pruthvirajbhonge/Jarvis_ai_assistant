<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030712">

    <!-- Subtle Particle Starfield Background -->
    <com.jarvis.assistant.ui.ParticleBackgroundView
        android:id="@+id/particleBgView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- TOP HUD STATUS HEADER -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card_active"
            android:drawablePadding="6dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="Connected\nPC Online"
            android:textColor="#00E676"
            android:textSize="11sp"
            android:textStyle="bold"
            app:drawableStartCompat="@android:drawable/ic_menu_compass"
            app:drawableTint="#00E676" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvJarvisTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.25"
                android:text="J.A.R.V.I.S."
                android:textColor="#00E5FF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="Your AI Assistant"
                android:textColor="#90CAF9"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchPcMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PC"
            android:textColor="#80D8FF"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btnNotification"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Notifications"
            android:src="@drawable/ic_bell"
            app:tint="#00E5FF" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:src="@drawable/ic_settings"
            app:tint="#00E5FF" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/mainScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- CENTRAL HOLOGRAPHIC ARC REACTOR 2.0 -->
            <FrameLayout
                android:id="@+id/reactorContainer"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_marginTop="4dp">

                <com.jarvis.assistant.ui.JarvisReactorView
                    android:id="@+id/reactorView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Legacy ImageViews hidden or kept for backwards safety -->
                <ImageView
                    android:id="@+id/ivReactorOuterRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/ivReactorCore"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <!-- STATUS BAR WITH LIVE PULSE -->
            <LinearLayout
                android:id="@+id/statusPillLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_glass_card"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp">

                <ImageView
                    android:id="@+id/ivStatusWave"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_wave_visualizer"
                    app:tint="#00E676" />

                <TextView
                    android:id="@+id/tvAssistantStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.05"
                    android:text="Say &quot;Hey Jarvis&quot;..."
                    android:textColor="#00E5FF"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- METRICS HUD CARD (BATTERY, CPU, RAM) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMetrics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#800A1628"
                app:cardCornerRadius="16dp"
                app:strokeColor="#1A3A5E"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvCpuMetric"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="93%"
                            android:textColor="#00E676"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Battery"
                            android:textColor="#90CAF9"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#1A3A5E" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvRamMetric"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="23%"
                            android:textColor="#00E5FF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CPU"
                            android:textColor="#90CAF9"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="#1A3A5E" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDiskMetric"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="67%"
                            android:textColor="#E040FB"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RAM"
                            android:textColor="#90CAF9"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- EXPANDABLE CONTROL DECK PANEL -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardControlDeck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#800A1628"
                app:cardCornerRadius="16dp"
                app:strokeColor="#00E5FF"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- SECTION SELECTOR HEADER (<< QUICK ACTIONS >>) -->
                    <LinearLayout
                        android:id="@+id/deckHeaderLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingVertical="4dp">

                        <TextView
                            android:id="@+id/btnPrevSection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="&lt;&lt;"
                            android:textColor="#00E5FF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDeckSectionTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:letterSpacing="0.15"
                            android:text="QUICK ACTIONS"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnNextSection"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="8dp"
                            android:text="&gt;&gt;"
                            android:textColor="#00E5FF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- GRID BUTTONS SECTION -->
                    <GridLayout
                        android:id="@+id/gridControlDeck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:columnCount="2"
                        android:rowCount="3">

                        <TextView
                            android:id="@+id/btnDeckAction1"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_quick_action_btn"
                            android:drawableStart="@drawable/ic_apps"
                            android:drawablePadding="10dp"
                            android:drawableTint="#00E5FF"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="14dp"
                            android:text="Open Apps"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnDeckAction2"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_quick_action_btn"
                            android:drawableStart="@drawable/ic_search"
                            android:drawablePadding="10dp"
                            android:drawableTint="#00E5FF"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="14dp"
                            android:text="Search Web"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnDeckAction3"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_quick_action_btn"
                            android:drawableStart="@drawable/ic_youtube"
                            android:drawablePadding="10dp"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="14dp"
                            android:text="Open YouTube"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnDeckAction4"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_quick_action_btn"
                            android:drawableStart="@drawable/ic_spotify"
                            android:drawablePadding="10dp"
                            android:drawableTint="#00E5FF"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="14dp"
                            android:text="Play Music"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnDeckAction5"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_quick_action_btn"
                            android:drawableStart="@drawable/ic_pc"
                            android:drawablePadding="10dp"
                            android:drawableTint="#00E5FF"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="14dp"
                            android:text="PC Control"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/btnDeckAction6"
                            android:layout_width="0dp"
                            android:layout_height="46dp"
                            android:layout_columnWeight="1"
                            android:layout_margin="4dp"
                            android:background="@drawable/bg_quick_action_btn"
                            android:drawableStart="@drawable/ic_tabs"
                            android:drawablePadding="10dp"
                            android:drawableTint="#00E5FF"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="14dp"
                            android:text="More Actions"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </GridLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ACTIVE BROWSER TABS CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardActiveTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#800A1628"
                app:cardCornerRadius="16dp"
                app:strokeColor="#1A3A5E"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvActiveTabsCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/ic_tabs"
                            android:drawablePadding="8dp"
                            android:drawableTint="#00E5FF"
                            android:letterSpacing="0.1"
                            android:text="ACTIVE TABS (2)"
                            android:textColor="#00E5FF"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnViewAllTabs"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="4dp"
                            android:text="View All -&gt;"
                            android:textColor="#90CAF9"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/tabsPreviewContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <!-- Tab Card 1 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardTab1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="#0D1E36"
                            app:cardCornerRadius="12dp"
                            app:strokeColor="#00E5FF"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="10dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_search"
                                    app:tint="#00E5FF" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:text="Google"
                                        android:textColor="#FFFFFF"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:text="www.google.com"
                                        android:textColor="#90CAF9"
                                        android:textSize="10sp" />
                                </LinearLayout>

                                <ImageButton
                                    android:id="@+id/btnCloseTab1"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:src="@drawable/ic_close"
                                    app:tint="#90CAF9" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Tab Card 2 -->
                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/cardTab2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="#0D1E36"
                            app:cardCornerRadius="12dp"
                            app:strokeColor="#1A3A5E"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:padding="10dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_youtube" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:text="YouTube"
                                        android:textColor="#FFFFFF"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:maxLines="1"
                                        android:text="m.youtube.com"
                                        android:textColor="#90CAF9"
                                        android:textSize="10sp" />
                                </LinearLayout>

                                <ImageButton
                                    android:id="@+id/btnCloseTab2"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:src="@drawable/ic_close"
                                    app:tint="#90CAF9" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- J.A.R.V.I.S. RESPONSE CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#800A1628"
                app:cardCornerRadius="16dp"
                app:strokeColor="#1A3A5E"
                app:strokeWidth="1.5dp">

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="100dp">

                    <TextView
                        android:id="@+id/tvResponseText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:padding="14dp"
                        android:text="J.A.R.V.I.S. is online and ready. How may I assist you, sir?"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </ScrollView>
            </com.google.android.material.card.MaterialCardView>

            <!-- COMMAND INPUT FIELD BAR -->
            <LinearLayout
                android:id="@+id/bottomInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etCommandInput"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_card"
                    android:hint="Type or speak a command..."
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:paddingHorizontal="16dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#546E7A"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btnMicToggle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_quick_action_btn"
                    android:contentDescription="Speak"
                    android:src="@drawable/ic_mic"
                    app:tint="#00E5FF" />

                <ImageButton
                    android:id="@+id/btnSend"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_reactor_center_btn"
                    android:contentDescription="Send"
                    android:src="@drawable/ic_send"
                    app:tint="#050B14" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- SCI-FI HOLOGRAPHIC BOTTOM NAVIGATION BAR -->
    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_nav_bar"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- NAV 1: HOME -->
        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavHome"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                app:tint="#00E5FF" />

            <TextView
                android:id="@+id/tvNavHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- NAV 2: TABS -->
        <LinearLayout
            android:id="@+id/navTabs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavTabs"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tabs"
                app:tint="#90CAF9" />

            <TextView
                android:id="@+id/tvNavTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tabs"
                android:textColor="#90CAF9"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- NAV 3: CENTRAL VOICE REACTOR PULSE BUTTON -->
        <FrameLayout
            android:id="@+id/navCentralReactorBtn"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_reactor_center_btn"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_wave_visualizer"
                app:tint="#050B14" />
        </FrameLayout>

        <!-- NAV 4: HISTORY -->
        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavHistory"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_history"
                app:tint="#90CAF9" />

            <TextView
                android:id="@+id/tvNavHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="History"
                android:textColor="#90CAF9"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- NAV 5: SETTINGS -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavSettings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_settings"
                app:tint="#90CAF9" />

            <TextView
                android:id="@+id/tvNavSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Settings"
                android:textColor="#90CAF9"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
