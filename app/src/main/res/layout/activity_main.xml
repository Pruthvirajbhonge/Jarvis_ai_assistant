<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#030712">

    <!-- Subtle Particle Starfield Background -->
    <com.jarvis.assistant.ui.ParticleBackgroundView
        android:id="@+id/particleBgView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- TOP HUD STATUS HEADER -->
    <!-- TOP HUD STATUS HEADER -->
    <LinearLayout
        android:id="@+id/topBarLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_glass_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvConnectionStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_card_active"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:text="● PHONE READY"
            android:textColor="#4DD0E1"
            android:textSize="10sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvJarvisTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.25"
                android:text="J.A.R.V.I.S."
                android:textColor="#00E5FF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="Your AI Assistant"
                android:textColor="#80D8FF"
                android:textSize="10sp" />
        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchPcMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PC"
            android:textColor="#80D8FF"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Settings"
            android:src="@drawable/ic_settings"
            app:tint="#00E5FF" />
    </LinearLayout>

    <!-- CONTENT VIEWS CONTAINER -->
    <FrameLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBarLayout">

        <!-- 1. HOME SCREEN VIEW (FULL WIDTH REACTOR & ZERO BOTTOM GAP) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/homeViewLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- CENTRAL HOLOGRAPHIC ARC REACTOR (FULL WIDTH & DYNAMIC HEIGHT) -->
            <FrameLayout
                android:id="@+id/reactorContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:padding="0dp"
                app:layout_constraintBottom_toTopOf="@+id/bottomControlsLayout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.jarvis.assistant.ui.JarvisReactorView
                    android:id="@+id/reactorView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Legacy ImageViews for safety -->
                <ImageView
                    android:id="@+id/ivReactorOuterRing"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/ivReactorCore"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <!-- DOCKED BOTTOM CONTROLS LAYOUT (ZERO GAP AT BOTTOM SIDE) -->
            <LinearLayout
                android:id="@+id/bottomControlsLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <!-- SINGLE STATUS PILL -->
                <LinearLayout
                    android:id="@+id/statusPillLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="Status Wave"
                        android:src="@drawable/ic_wave_visualizer"
                        app:tint="#4DD0E1" />

                    <TextView
                        android:id="@+id/tvAssistantStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.05"
                        android:text="Tap to Speak"
                        android:textColor="#00E5FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- QUICK ACTION PILLS (Open Apps | System Info | More) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/pillOpenApps"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_glass_card"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="Open Apps"
                        android:textColor="#00E5FF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/pillSystemInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_glass_card"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="System Info"
                        android:textColor="#00E5FF"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/pillMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:text="More v"
                        android:textColor="#00E5FF"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- METRICS HUD CARD (COMPACT) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardMetrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="#800A1628"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#1A3A5E"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="6dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvCpuMetric"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="93%"
                                android:textColor="#00E676"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Battery"
                                android:textColor="#90CAF9"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#1A3A5E" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvRamMetric"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="23%"
                                android:textColor="#00E5FF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CPU"
                                android:textColor="#90CAF9"
                                android:textSize="10sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#1A3A5E" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDiskMetric"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="67%"
                                android:textColor="#E040FB"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RAM"
                                android:textColor="#90CAF9"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- EXPANDABLE CONTROL DECK PANEL (COMPACT) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardControlDeck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="#800A1628"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#00E5FF"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <LinearLayout
                            android:id="@+id/deckHeaderLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:paddingVertical="2dp">

                            <TextView
                                android:id="@+id/btnPrevSection"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="6dp"
                                android:text="&lt;&lt;"
                                android:textColor="#00E5FF"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDeckSectionTitle"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:letterSpacing="0.12"
                                android:text="QUICK ACTIONS ▼"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btnNextSection"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="6dp"
                                android:text="&gt;&gt;"
                                android:textColor="#00E5FF"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <GridLayout
                            android:id="@+id/gridControlDeck"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:columnCount="2"
                            android:rowCount="3"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/btnDeckAction1"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="3dp"
                                android:background="@drawable/bg_quick_action_btn"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp"
                                android:text="Open Apps"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                app:drawableStartCompat="@drawable/ic_apps"
                                app:drawableTint="#00E5FF" />

                            <TextView
                                android:id="@+id/btnDeckAction2"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="3dp"
                                android:background="@drawable/bg_quick_action_btn"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp"
                                android:text="Search Web"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                app:drawableStartCompat="@drawable/ic_search"
                                app:drawableTint="#00E5FF" />

                            <TextView
                                android:id="@+id/btnDeckAction3"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="3dp"
                                android:background="@drawable/bg_quick_action_btn"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp"
                                android:text="Open YouTube"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                app:drawableStartCompat="@drawable/ic_youtube" />

                            <TextView
                                android:id="@+id/btnDeckAction4"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="3dp"
                                android:background="@drawable/bg_quick_action_btn"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp"
                                android:text="Play Music"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                app:drawableStartCompat="@drawable/ic_spotify"
                                app:drawableTint="#00E5FF" />

                            <TextView
                                android:id="@+id/btnDeckAction5"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="3dp"
                                android:background="@drawable/bg_quick_action_btn"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp"
                                android:text="PC Control"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                app:drawableStartCompat="@drawable/ic_pc"
                                app:drawableTint="#00E5FF" />

                            <TextView
                                android:id="@+id/btnDeckAction6"
                                android:layout_width="0dp"
                                android:layout_height="40dp"
                                android:layout_columnWeight="1"
                                android:layout_margin="3dp"
                                android:background="@drawable/bg_quick_action_btn"
                                android:drawablePadding="8dp"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp"
                                android:text="More Actions"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                app:drawableStartCompat="@drawable/ic_tabs"
                                app:drawableTint="#00E5FF" />
                        </GridLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- J.A.R.V.I.S. RESPONSE CARD (COMPACT 52dp) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardResponse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:cardBackgroundColor="#800A1628"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="#1A3A5E"
                    app:strokeWidth="1dp">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="52dp">

                        <TextView
                            android:id="@+id/tvResponseText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="2dp"
                            android:padding="8dp"
                            android:text="J.A.R.V.I.S. is online and ready. How may I assist you, sir?"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp" />
                    </ScrollView>
                </com.google.android.material.card.MaterialCardView>

                <!-- COMMAND INPUT BAR (COMPACT 40dp) -->
                <LinearLayout
                    android:id="@+id/bottomInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etCommandInput"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_card"
                        android:hint="Say something..."
                        android:imeOptions="actionSend"
                        android:inputType="text"
                        android:paddingHorizontal="14dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#546E7A"
                        android:textSize="12sp" />

                    <ImageButton
                        android:id="@+id/btnMicToggle"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_quick_action_btn"
                        android:contentDescription="Speak"
                        android:src="@drawable/ic_mic"
                        app:tint="#00E5FF" />

                    <ImageButton
                        android:id="@+id/btnSend"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_reactor_center_btn"
                        android:contentDescription="Send"
                        android:src="@drawable/ic_send"
                        app:tint="#050B14" />
                </LinearLayout>

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 2. TABS SCREEN VIEW (SCREEN 4 IN REFERENCE IMAGE) -->
        <LinearLayout
            android:id="@+id/tabsViewLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <!-- TAB PILL HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_glass_card_active"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="Home"
                    android:textColor="#00E5FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_glass_card"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="YouTube"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnAddTab"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    android:text="+"
                    android:textColor="#00E5FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- RECYCLER VIEW TAB CARDS -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTabCards"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMainCloseAllTabs"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#0E223D"
                android:text="🗑️ Close All"
                android:textColor="#FF5252"
                app:cornerRadius="12dp"
                app:strokeColor="#FF5252"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- 3. HISTORY SCREEN VIEW -->
        <LinearLayout
            android:id="@+id/historyViewLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.15"
                android:text="COMMAND HISTORY"
                android:textColor="#00E5FF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tvHistoryLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:lineSpacingExtra="6dp"
                    android:padding="16dp"
                    android:text="• Initialized J.A.R.V.I.S. Core 3.0\n• System Online\n• Waiting for voice command..."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />
            </ScrollView>
        </LinearLayout>

        <!-- 4. SETTINGS SCREEN VIEW (SCREEN 5 IN REFERENCE IMAGE) -->
        <ScrollView
            android:id="@+id/settingsViewLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- SETTINGS HEADER PROFILE AVATAR -->
                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_reactor_center_btn">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="J"
                        android:textColor="#050B14"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:letterSpacing="0.15"
                    android:text="J.A.R.V.I.S."
                    android:textColor="#00E5FF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v2.0.0"
                    android:textColor="#90CAF9"
                    android:textSize="11sp" />

                <!-- GLASS SETTINGS LIST -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🎙️ Background Mic"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/setSwitchBgMic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1A3A5E" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🌐 Browser Mic"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/setSwitchBrowserMic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1A3A5E" />

                    <LinearLayout
                        android:id="@+id/setRowVoiceLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🗣️ Voice Language"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvSetVoiceLang"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Marathi (mr-IN) v"
                            android:textColor="#00E5FF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1A3A5E" />

                    <LinearLayout
                        android:id="@+id/setRowWakeWord"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="⚡ Wake Word"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hey Jarvis v"
                            android:textColor="#00E5FF"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1A3A5E" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="🎨 Animations"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/setSwitchAnimations"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenFullSettings"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:backgroundTint="#0E223D"
                    android:text="⚙️ Advanced AI Keys &amp; System Permissions"
                    android:textColor="#00E5FF"
                    app:cornerRadius="12dp"
                    app:strokeColor="#00E5FF"
                    app:strokeWidth="1dp" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- SCI-FI BOTTOM NAVIGATION BAR -->
    <LinearLayout
        android:id="@+id/bottomNavLayout"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_nav_bar"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavHome"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Home"
                android:src="@drawable/ic_home"
                app:tint="#00E5FF" />

            <TextView
                android:id="@+id/tvNavHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Home"
                android:textColor="#00E5FF"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navTabs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavTabs"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Tabs"
                android:src="@drawable/ic_tabs"
                app:tint="#90CAF9" />

            <TextView
                android:id="@+id/tvNavTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tabs"
                android:textColor="#90CAF9"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- NAV 3: CENTRAL VOICE REACTOR PULSE BUTTON (PERFECT ALIGNMENT) -->
        <LinearLayout
            android:id="@+id/navCentralReactorBtn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_reactor_center_btn"
                android:elevation="4dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Reactor Voice"
                    android:src="@drawable/ic_wave_visualizer"
                    app:tint="#050B14" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavHistory"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="History"
                android:src="@drawable/ic_history"
                app:tint="#90CAF9" />

            <TextView
                android:id="@+id/tvNavHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="History"
                android:textColor="#90CAF9"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavSettings"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="Settings"
                android:src="@drawable/ic_settings"
                app:tint="#90CAF9" />

            <TextView
                android:id="@+id/tvNavSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Settings"
                android:textColor="#90CAF9"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
