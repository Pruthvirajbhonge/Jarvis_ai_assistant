<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android cannot express CIDR ranges (192.168.0.0/16 etc.) as <domain>, so cleartext is
         permitted globally. This is what allows http:// and ws:// to the PC's LAN IP. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
